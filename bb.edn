{:paths ["src" "spec"]

 :deps  {speclj/speclj {:mvn/version "3.13.0"}}

 :tasks
 {bean-gate     {:doc  "Bean Gate: `bean-gate baseline <id> <repo>:<path>[:<line>…]…` (planner) | `bean-gate verify <id>` (worker, CI)"
                 :task (apply (requiring-resolve 'isaac.bean-gate.main/-main) *command-line-args*)}

  spec          {:doc  "Run speclj specs (default target: spec/)"
                 :task (apply (requiring-resolve 'speclj.main/-main) "-c" (or (seq *command-line-args*) ["spec"]))}

  ci            {:doc  "Everything the pre-push hook and CI gate on"
                 :task (run 'spec)}

  hooks:install {:doc  "Configure git to use repo-tracked hooks"
                 :task (shell "git" "config" "core.hooksPath" ".githooks")}}}
