diff --git a/src/isaac/agent/session/store/spi.clj b/src/isaac/agent/session/store/spi.clj
index 2a99550..069e0ce 100644
--- a/src/isaac/agent/session/store/spi.clj
+++ b/src/isaac/agent/session/store/spi.clj
@@ -88,8 +88,25 @@
 (defn can-dispatch? [store session-id]
   (not (in-flight? store session-id)))
 
+(defn- tag-keyword [tag]
+  (cond
+    (keyword? tag) tag
+    (symbol? tag)  (keyword tag)
+    (string? tag)  (when-not (str/blank? tag) (keyword tag))))
+
+(defn normalize-tags
+  "Tags are a set of keywords. nil, a set, or a sequential collection — a
+   vector or list of keywords or their names — all become that set. Anything
+   else is returned unchanged so schema can reject it (`\"not-a-set\"`)."
+  [tags]
+  (cond
+    (nil? tags) #{}
+    (or (set? tags) (sequential? tags)) (into #{} (keep tag-keyword) tags)
+    :else tags))
+
 (defn tags-of [session]
-  (or (:tags session) #{}))
+  (let [tags (normalize-tags (:tags session))]
+    (if (set? tags) tags #{})))
 
 (defn has-tag? [session tag]
   (contains? (tags-of session) tag))
